#!/bin/sh
#
# Cudy TR3000 首次启动网络配置（uci-defaults，只在首次启动执行一次）。
# 固件内路径 /etc/uci-defaults/99-cudy-tr3000-defaults，由 /etc/init.d/boot 执行，
# 晚于 board.d 的 02_network、早于 network 服务启动，可直接覆盖生成的 network 配置。
#
# 依据（ImmortalWrt v25.12.2）：config_generate 为 lan 建 bridge（network.@device[0]=br-lan）；
# 02_network 默认 lan=eth1、wan=eth0；两网口直连 MAC/PHY（eth0=gmac0、eth1=gmac1）。
#
# 本脚本：1) eth0/eth1 都归 lan；2) lan 地址 10.0.0.1/8；3) Argon 使用本地壁纸。
#

# ---- 1) 把两个物理网口都收进 lan ----
# wan 物理口从生成好的配置读，不写死，耐上游对调
WAN_PORT=$(uci -q get network.wan.device)

# log 原始分配，便于日后排查
logger -t cudy-tr3000-defaults "原 lan 口: $(uci -q get network.lan.device) / 原 wan 口: ${WAN_PORT:-无}"

# lan 的 bridge 段通常就是 @device[0]；校验名字，防止生成顺序变化时改错对象
LAN_DEV_NAME=$(uci -q get network.@device[0].name)
if [ "$LAN_DEV_NAME" != "br-lan" ]; then
    logger -t cudy-tr3000-defaults "network.@device[0] 不是 br-lan（实际: ${LAN_DEV_NAME:-空}），跳过网口归并"
else
    uci -q delete network.@device[0].ports
    uci add_list network.@device[0].ports='eth1'
    [ -n "$WAN_PORT" ] && uci add_list network.@device[0].ports="$WAN_PORT"
fi

# wan 保留接口但不绑物理口（proto=none）；firewall 的 wan 区域仍引用它
uci -q delete network.wan.device
uci set network.wan.proto='none'

# ---- 2) 默认 lan 口 IP：10.0.0.1/8 ----
uci set network.lan.proto='static'
uci set network.lan.ipaddr='10.0.0.1'
uci set network.lan.netmask='255.0.0.0'

# 如需指定上游 DNS（不设则由 wan/dhcp 提供；本固件默认无 wan 口，建议按需取消注释）：
# uci add_list network.lan.dns='223.5.5.5'

uci commit network

# 不在此处 network reload：uci-defaults 早于 network 服务启动，改动会被直接采用；
# 主动 reload 反而可能在启动早期制造短暂中断。

# ---- 3) Argon 壁纸来源设为「本地 / Built-in」----
# luci-app-argon-config 默认 online_wallpaper='bing'，本地图不会被用；设为 'none' 后
# 主题 sysauth.ut 会扫描 /www/luci-static/argon/background/ 随机取图，目录为空才回落到 img/bg1.jpg。
# 因此壁纸只需放进 background/（见 README），无需改模板或本脚本。
# 本文件序号 99 晚于该包默认值；argon 未启用时 uci 会失败，用 || true 忽略。
uci -q set argon.@global[0].online_wallpaper='none' || true
uci -q commit argon || true
# 清掉可能已缓存的在线壁纸地址（缓存文件在 /var，重启即消失，这里只作兜底）
rm -f /var/run/argon_bing.url /var/run/argon_unsplash.url 2>/dev/null || true

exit 0
